{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story uses the camera to capture your moments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale 使用相机来拍摄你的片段。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story records audio with your video moments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale 会在你拍摄片段时录制声音。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story saves a copy of your captured moments to your Photos library so you own them outside Story."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale 会把你拍摄的片段保存一份到“照片”，这样你在 YoTale 之外也能保留它们。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story can import existing photos and videos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale 可以导入你已有的照片和视频。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Story can tag the Moments you record with where you captured them, so your travel memories remember the place. Location is optional and never added to the videos you share."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YoTale 可以为你拍摄的片段标注拍摄地点，让旅行回忆记住那个地方。位置信息为可选项，也不会添加到你分享的视频中。"
          }
        }
      }
    }
  }
}