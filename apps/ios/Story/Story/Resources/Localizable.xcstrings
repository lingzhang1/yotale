    },
    "%@ analyzed · paused, daily limit reached — resumes tomorrow": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分析 %@ · 已暂停：今日已达上限，明天继续"
