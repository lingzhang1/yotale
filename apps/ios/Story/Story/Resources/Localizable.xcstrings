        }
      }
    },
    "The original video is uploaded privately to your YoTale account so it's safe if you lose this phone. It stays on this device too — nothing is deleted. Only you can access it; it won't appear for another account on this phone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
