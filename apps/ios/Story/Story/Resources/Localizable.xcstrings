    },
    "%@ analyzed · sign in to continue": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分析 %@ · 登录后继续"
          }
        }
      }
    },
    "%@ analyzed · waiting for network": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分析 %@ · 等待网络"
          }
        }
      }
    },
    "%@ are still being analyzed. Give them a moment, then create your Story — your instruction is saved.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在分析中。稍等片刻再生成故事吧——你的要求已保存。"
          }
        }
      }
    },
    "%@ couldn't be matched (this Story has %lld). Choose Moments with “Arrange Moments”, or rephrase.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法匹配 %1$@（这个故事共有 %2$lld 个片段）。请通过“排序片段”选择片段，或换种说法。"
          }
        }
      }
    },
    "%@ couldn't be matched (this Story has %lld). Reposition it with “Arrange”, or rephrase.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法匹配 %1$@（这个故事共有 %2$lld 个片段）。请用“排序”调整位置，或换种说法。"
          }
        }
      }
    },
    "%@ is both in your arranged order and asked to be dropped. Remove it from the order, or don’t drop it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 既在你排好的顺序中，又被要求去掉。请把它从顺序中移除，或不要去掉它。"
          }
        }
      }
    },
    "%@ is in your Moment sequence but your text asks to drop it. Remove it from the sequence, or edit the text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你的片段顺序中，但你的文字要求去掉它。请把它从顺序中移除，或修改文字。"
          }
        }
      }
    },
    "%@ is still being analyzed. Give it a moment, then create your Story — your instruction is saved.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在分析中。稍等片刻再生成故事吧——你的要求已保存。"
          }
        }
      }
    },
    "%@ isn’t in your selected Moments. Add it in Arrange, or remove the mention.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在你选中的片段里。请在“排序”中添加，或删掉这处提及。"
          }
        }
      }
    },
    "%@ isn’t in your sequence, which is set to “Use only the selected Moments”. Add it in Arrange Moments, change that setting, or edit the text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在你的顺序中，而顺序已设为“只使用选中的片段”。请在“排序片段”中添加它、更改该设置，或修改文字。"
          }
        }
      }
    },
    "%@ right after %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 紧接在 %2$@ 之后"
          }
        }
      }
    },
    "%@ will open the video": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将作为开场"
          }
        }
      }
    },
    "%@ will open the video and %@ will end it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将作为开场，%2$@ 将作为结尾"
          }
        }
      }
    },
    "%@ · ~%lld sec": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · 约 %2$lld 秒"
          }
        }
      }
    },
    "%@. %@%@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。%@%@"
          }
        }
      }
    },
    "%@. Moments %@ are required in this intended order; the editor may include other Moments between them, and keeps your order when the footage allows.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。片段 %2$@ 需要按此顺序出现；剪辑可能会在它们之间穿插其他片段，并在素材允许时保持你的顺序。"
          }
        }
      }
    },
    "%@. Moments %@ will follow this intended order. The rest of your video stays as it is. If the footage can't fully allow it, the result says so rather than forcing it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。片段 %2$@ 将按此顺序排列，视频的其余部分保持不变。如果素材无法完全满足，结果会如实告知，而不会强行处理。"
          }
        }
      }
    },
    "%@. Only Moments %@ will be used, in this intended order. The editor keeps your order when the footage allows; if it can't fully honor it, the result is shown honestly rather than forced.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@。只会使用片段 %2$@，并按此顺序排列。素材允许时会保持你的顺序；如果无法完全做到，结果会如实呈现，而不会强行处理。"
          }
        }
      }
    },
